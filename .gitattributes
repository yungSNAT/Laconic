# Shell scripts must keep LF endings so sh can run them from Windows checkouts.
*.sh text eol=lf

# The fact-survival summary fixture is compared byte for byte with what the tool prints.
tools/laconic-evals/src/**/*.json text eol=lf

# The record fixtures are compared byte for byte with what the record steps write.
tools/laconic-evals/src/record/fixtures/** text eol=lf
